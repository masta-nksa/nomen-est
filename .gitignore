*.pdf
*.zip
/pdfs/
/testdata/

# Claude Code local session config (machine-specific, not for the team)
.claude/settings.local.json

# Drift's web assets — fetched by tool/fetch_web_assets.sh, not vendored
/web/sqlite3.wasm
/web/drift_worker.js
